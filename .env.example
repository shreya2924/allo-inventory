# Supabase Postgres (Session mode pooler for DATABASE_URL, direct connection for DIRECT_URL)
DATABASE_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.[project-ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres"

# Upstash Redis
UPSTASH_REDIS_REST_URL="https://your-redis.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-token-here"

# Reservation window in minutes (default: 10)
RESERVATION_TTL_MINUTES=10

# Cron secret to protect /api/cron/expire
CRON_SECRET="a-random-secret-string"
